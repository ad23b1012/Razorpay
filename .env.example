# ==============================================================================
# RAZORAGENT ENVIRONMENT CONFIGURATION (100% FREE TIER COMPATIBLE)
# ==============================================================================

# 1. Razorpay Developer Test Keys (Free from https://dashboard.razorpay.com/app/keys)
# Fill these in and the real Razorpay Checkout opens at payment time, orders are
# created on Razorpay, and signatures are verified by Razorpay's own SDK.
# Leave them as-is and the app runs in SIMULATION mode: orders are emulated
# locally and clearly labelled in the UI, while payment signatures are still
# verified with the same HMAC-SHA256 check. There is no unverified path.
RAZORPAY_KEY_ID=rzp_test_TVj1aNqcReFbcc
RAZORPAY_KEY_SECRET=ruXl2AKDMkknbZyPvPI9a6MG

# Needed to accept webhooks. Unsigned webhook payloads are rejected outright.
RAZORPAY_WEBHOOK_SECRET=demo_webhook_secret_123

# Force simulation even when real keys are present. Set to false to use the keys.
RAZORPAY_MOCK_MODE=false

# 2. Google Gemini API Key (Free from https://aistudio.google.com/)
# If left empty, RazorAgent runs high-precision local deterministic reasoning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3. Database URL (Free Supabase PostgreSQL or local SQLite)
# Supabase example: postgresql+asyncpg://postgres:YourPassword@db.xxxx.supabase.co:5432/postgres
# Leave empty for automatic local async SQLite storage:
SUPABASE_DATABASE_URL=https://ksotifwdfykwlvdkgcmr.supabase.co
DATABASE_URL=sqlite+aiosqlite:///./razoragent.db

# 4. Merchant Policy Boundaries ("THE BAR")
MAX_GLOBAL_DISCOUNT_PERCENT=20.0
DEFAULT_OFFER_DISCOUNT_PERCENT=12.0
DAILY_CAMPAIGN_BUDGET_INR=50000.0
APPROVAL_GATE_THRESHOLD_INR=5000.0
MIN_CART_VALUE_FOR_OFFER_INR=1500.0

# 5. CORS allowlist (comma-separated). Name your deployed frontend here.
# Wildcards are deliberately not supported: this API takes money actions.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
